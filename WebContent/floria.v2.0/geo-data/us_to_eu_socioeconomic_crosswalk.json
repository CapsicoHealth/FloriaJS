{
  "metadata": {
    "purpose": "Synthetic geographic crosswalk for visualizing US county-level sales data on EU maps.",
    "method": "Socio-economic analogy, not a statistical equivalence. US states are mapped to EU countries with broadly comparable economic scale, urbanization, industrial/service mix, population density, and regional diversity. US counties are mapped to NUTS 3 regions with broadly comparable metropolitan, suburban, industrial, coastal, or rural profiles.",
    "eu_region_level": "NUTS 2",
    "nuts_version": "2024",
    "source_note": "NUTS is Eurostat's official regional statistical classification. NUTS 3 is the small-region level used for specific diagnoses; it is the closest practical EU analogue to US counties for this visualization use case.",
    "state_selection": "10 large US states selected for population/economic significance; the county lists are the 10 most prominent counties by population/economic activity rather than a claim about the user's sales ranking.",
    "synthetic": true,
    "region_note": "NUTS 2 is used here because it is the EU's principal regional-policy/basic-region level and provides a stable, practical mapping target for county-level visualization. Multiple US counties may intentionally map to the same NUTS 2 region."
  },
